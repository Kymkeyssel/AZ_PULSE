###############################################################################
# AZ PULSE — Service IA (FastAPI)
#
# COPIER ce fichier en `.env` puis compléter les valeurs réelles.
#   cp .env.example .env
#
# RÈGLE ABSOLUE : les clés fournisseurs ne doivent jamais être versionnées.
# `.env` est ignoré par git (voir .gitignore racine).
###############################################################################

# ── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Sécurité ────────────────────────────────────────────────────────────────
# DOIT être identique à AI_SERVICE_TOKEN du .env Symfony.
# C'est ce secret qui empêche un tiers d'appeler le service IA.
AI_SERVICE_TOKEN=

# ── Fournisseur de modèle ───────────────────────────────────────────────────
# AZ PULSE n'héberge pas de LLM : le service appelle un fournisseur par API.
# Un seul fournisseur actif suffit (celui qui a une clé).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OPENAI_API_KEY=

# ── Retour vers Symfony ─────────────────────────────────────────────────────
# Rappel d'architecture (§9.1) : FastAPI ne doit JAMAIS accéder directement à
# PostgreSQL pour contourner Symfony. Il ne connaît que son point d'entrée.
SYMFONY_API_BASE_URL=http://localhost:8080/api
SYMFONY_API_KEY=
