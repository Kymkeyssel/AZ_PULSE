###############################################################################
# AZ PULSE — Backend Symfony
#
# COPIER ce fichier en `.env` puis compléter les valeurs réelles.
#   cp .env.example .env
#
# RÈGLE ABSOLUE : aucun secret réel ne doit être écrit dans un fichier
# versionné. Le fichier `.env` est ignoré par git (voir .gitignore).
###############################################################################

###> symfony/framework-bundle ###
APP_ENV=dev
# Générer avec : php bin/console secrets:set AppSecret
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Base principale. Le service `postgres` de Docker/docker-compose.yml expose
# déjà la base `azpulse` sur le port 5432.
DATABASE_URL="postgresql://azpulse:CHANGEME@127.0.0.1:5432/azpulse?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/cache ###
REDIS_URL="redis://127.0.0.1:6379"
###< symfony/cache ###

###> symfony/messenger ###
# Transport de la file d'emails (asynchrone). `sync://` en développement
# si l'on veut voir les erreurs immédiatement.
MESSENGER_TRANSPORT_DSN=doctrine://default?queue_name=email
###< symfony/messenger ###

###> symfony/mailer ###
# Développement : Mailpit (docker compose → http://localhost:8025)
# MAILER_DSN=null://null
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/resend-mailer ###
# Production uniquement. Ne jamais versionner la clé.
# MAILER_RESEND_SECRET=
MAILER_RESEND_SECRET=
###< symfony/resend-mailer ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> azpulse/ai-service ###
# Service FastAPI local. Il s'authentifie avec AI_SERVICE_TOKEN côté Symfony
# ET côté Python : les deux valeurs DOIVENT correspondre.
# Générer une valeur aléatoire forte, ex. :
#   php -r "echo bin2hex(random_bytes(32));"
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=
###< azpulse/ai-service ###

###> azpulse/glpi ###
# GLPI reste le système spécialisé de l'inventaire (§8). Symfony est le seul
# à l'appeler, via App\Service\GlpiService.
GLPI_API_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
###< azpulse/glpi ###

###> azpulse/n8n ###
# Pont d'événements vers n8n (§10). Laisser vide pour désactiver.
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_BASE=
N8N_API_KEY=
###< azpulse/n8n ###
